# Valhalla pedestrian routing. Public OSM demo server is the default; set your own hosted instance for production.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
# PostgreSQL/PostGIS; Docker Compose overrides host `db` for its app container.
POSTGRES_DB=saferoute
POSTGRES_USER=saferoute
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgres://saferoute:change-me-locally@localhost:5432/saferoute
SYNC_POLL_SECONDS=60
QAMQOR_SYNC_INTERVAL_MINUTES=1440
QAMQOR_SYNC_DELAY_MS=1000
# Set to 1 only when intentionally running the unauthenticated local admin demo.
DEV_ADMIN_MODE=1
# Direct OpenStreetMap raster tiles by default; set another compatible provider when needed.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
